# Настройки сервера. Проще всего создать этот файл скриптом: sudo ./deploy/install.sh
# Вручную: cp .env.example .env и заполните. Секреты: openssl rand -hex 32

# Домен, на котором будет работать платформа (DNS-запись A → IP этого сервера)
DOMAIN=taxi.example.com
# Почта для Let's Encrypt (уведомления о сертификате) и контакт для геокодера
ACME_EMAIL=you@example.com

NODE_ENV=production
POSTGRES_PASSWORD=
JWT_SECRET=
SUPER_ADMIN_KEY=

# Тестовый вход без Telegram — в продакшене только false
DEV_AUTH=false
MIGRATE_ON_START=true

# Демо-режим для показа клиентам: водители таксопарка DEMO_TENANT_SLUG
# ездят сами и принимают заказы. На реальном таксопарке не включать.
DEMO_SIMULATOR=false
DEMO_TENANT_SLUG=demo

# Поиск адресов и маршруты
GEOCODER_USER_AGENT="taxi-platform (contact: you@example.com)"
OSRM_URL=

# Сколько дней хранить бэкапы базы
BACKUP_KEEP_DAYS=14
