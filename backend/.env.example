# Порт API
PORT=3000

# База данных и Redis
DATABASE_URL=postgres://taxi:taxi@localhost:5432/taxi
REDIS_URL=redis://localhost:6379

# Секрет для токенов. ОБЯЗАТЕЛЬНО замените на длинную случайную строку в продакшене:
#   openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Ключ супер-админа (это вы — владелец платформы). Нужен для создания таксопарков.
SUPER_ADMIN_KEY=change-me-too

# Тестовый вход для пассажиров и водителей без Telegram (только для разработки!)
# В продакшене должно быть false — вход будет через Telegram (этап 2).
DEV_AUTH=true

# Применять миграции базы автоматически при старте
MIGRATE_ON_START=true

# Свой сервер маршрутов OSRM (необязательно). Если пусто — расстояние считается по прямой с поправкой на дороги.
OSRM_URL=

# Подбор водителя
OFFER_TIMEOUT_SEC=15          # сколько секунд водитель думает над заказом
SEARCH_RADII_KM=2,5,10        # радиусы поиска по очереди
ORDER_SEARCH_TIMEOUT_SEC=300  # через сколько секунд поиска заказ считается просроченным
DRIVER_LOCATION_TTL_SEC=60    # водитель без координат дольше этого времени не получает заказы
DISPATCH_SWEEP_MS=1000        # как часто проверять заказы в поиске

# ---- Этап 2: Telegram и Mini App ----
# Публичный адрес сервера с HTTPS. Mini App будет на PUBLIC_URL/app/
PUBLIC_URL=
# Геокодер (поиск адресов). По умолчанию публичный Nominatim — ~1 запрос/сек.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT="taxi-platform (contact: you@example.com)"
GEOCODER_LANGUAGE=ru
